# Everkind Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Database Configuration
# =============================================================================

# MySQL/MariaDB connection settings
DB_HOST=localhost
DB_PORT=3306
DB_NAME=everkind
DB_USER=root
DB_PASSWORD=your_password_here

# =============================================================================
# Flask Configuration
# =============================================================================

# Set to 'production' in production environments
FLASK_ENV=development

# Generate a strong secret key for session management
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_random_string

# =============================================================================
# Security (Optional)
# =============================================================================

# Session lifetime in minutes (default: 30)
# SESSION_LIFETIME=30

# Enable HTTPS-only cookies in production
# SESSION_COOKIE_SECURE=true

# =============================================================================
# Email (Future Feature)
# =============================================================================

# SMTP settings for notifications
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your_email@gmail.com
# MAIL_PASSWORD=your_app_password
# MAIL_USE_TLS=true
